# Copy this file to .env and fill in your own values. Never commit .env.
NOTION_TOKEN=your-notion-integration-token
NOTION_DATABASE_ID=your-notion-database-id
GEMINI_API_KEY=your-gemini-api-key

# Folder that contains 01_A_Traiter and 02_Archives. It may start with ~.
DRIVE_ROOT="~/Library/CloudStorage/GoogleDrive-your.address@example.com/My Drive/assistant-cours"

# Optional: Gemini models, tried in this order until one answers
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Optional: how much a model thinks before it writes. Use one of the two, or leave both empty.
# NIVEAU_REFLEXION: minimal, low, medium or high. BUDGET_REFLEXION: a number of tokens (-1: the model decides, 0: none).
NIVEAU_REFLEXION=
BUDGET_REFLEXION=

# Optional, read only by tests/test_privacy.py: words that must never appear in the repository,
# separated by commas (your name, your address, your school...)
PRIVATE_WORDS=
